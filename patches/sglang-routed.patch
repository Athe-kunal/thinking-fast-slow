diff --git a/python/sglang/srt/dllm/algorithm/routed.py b/python/sglang/srt/dllm/algorithm/routed.py
new file mode 100644
index 000000000..50eca3874
--- /dev/null
+++ b/python/sglang/srt/dllm/algorithm/routed.py
@@ -0,0 +1,318 @@
+"""Routed decoding: a learned router picks AR or block diffusion per segment.
+
+Mirrors the HF reference decoder in thinking-fast-slow's `src/interleave.py`:
+
+- After the prompt prefill, each request has a seed token (argmax of the causal
+  next-token logits) and a boundary state (final hidden state + logit
+  statistics at the last committed token).
+- At a decision point the `RouterPolicy` (model submodule `router`) picks AR
+  (decode `ar_chunk` tokens, one per call) or diffusion (one block: seed at
+  position 0, remaining positions denoised with confidence-threshold
+  unmasking over bidirectional passes).
+- Every call ends with one causal pass that persists the KV cache; AR requests
+  commit 1 token, diffusion requests commit the whole block (truncated after
+  EOS). The scheduler frees the KV of uncommitted positions.
+
+Per-request decisions (float32 features, action, log-prob) and per-call costs
+are appended to `<trace_dir>/<rid>.jsonl` for RL training.
+
+Per-request state is kept on the CPU and holds only the router features
+(hidden state + two logit statistics), ~12 KB per request. Requests that end
+without EOS (length limit, abort) are never seen finishing here; their state
+is evicted by the LRU cap.
+"""
+
+import base64
+import collections
+import json
+import logging
+import os
+from typing import List, Optional
+
+import msgspec
+import numpy as np
+import torch
+
+from sglang.srt.dllm.algorithm.fastdiffuser import FastDiffuser
+from sglang.srt.dllm.config import DllmConfig
+from sglang.srt.dllm.router_policy import ACTION_AR, ACTION_DLM, RouterPolicy
+from sglang.srt.layers.logits_processor import LogitsProcessorOutput
+from sglang.srt.model_executor.forward_batch_info import ForwardBatch
+from sglang.srt.model_executor.model_runner import ModelRunner
+
+logger = logging.getLogger(__name__)
+
+_MAX_TRACKED_REQUESTS = 20000
+
+
+class _ReqState(msgspec.Struct):
+    """Per-request routing state between scheduler calls."""
+
+    seed: int
+    hidden: torch.Tensor  # (hidden,) float32 CPU, causal state at boundary
+    entropy: float  # next-token entropy (nats) at the boundary
+    top1: float  # next-token top-1 probability at the boundary
+    last_dlm: bool = False
+    mode: Optional[int] = None  # action of the current segment, None = decide
+    ar_left: int = 0
+    num_generated: int = 0
+
+
+class RoutedDecoding(FastDiffuser):
+    """AR/diffusion routing with a learned per-segment policy."""
+
+    def __init__(self, config: DllmConfig) -> None:
+        super().__init__(config)
+        cfg = config.algorithm_config
+        self.ar_chunk: int = int(cfg.get("ar_chunk", 8))
+        # The first `forced_ar_tokens` generated tokens are always AR; the
+        # router is not consulted (and nothing is traced) until then.
+        self.forced_ar_tokens: int = int(cfg.get("forced_ar_tokens", 0))
+        self.policy_mode: str = cfg.get("policy_mode", "sample")
+        self.trace_dir: Optional[str] = cfg.get("trace_dir")
+        self.router_checkpoint: Optional[str] = cfg.get("router_checkpoint")
+        self._states: "collections.OrderedDict[str, _ReqState]" = (
+            collections.OrderedDict()
+        )
+        self._router: Optional[RouterPolicy] = None
+        if self.trace_dir:
+            os.makedirs(self.trace_dir, exist_ok=True)
+        logger.info(
+            "RoutedDecoding: block_size=%d ar_chunk=%d forced_ar_tokens=%d "
+            "threshold=%s policy_mode=%s trace_dir=%s",
+            self.block_size,
+            self.ar_chunk,
+            self.forced_ar_tokens,
+            self.threshold,
+            self.policy_mode,
+            self.trace_dir,
+        )
+
+    def setup(self, model_runner: ModelRunner) -> None:
+        router = model_runner.model.router
+        if self.router_checkpoint:
+            loaded = RouterPolicy.load(self.router_checkpoint)
+            router.load_state_dict(loaded.state_dict())
+            logger.info("RoutedDecoding: loaded router %s", self.router_checkpoint)
+        self._router = router
+
+    def run(
+        self,
+        model_runner: ModelRunner,
+        forward_batch: ForwardBatch,
+        algo_states=None,
+    ):
+        if self._router is None:
+            self.setup(model_runner)
+        if not (forward_batch.input_ids == self.mask_id).any():
+            return self._prefill(model_runner=model_runner, forward_batch=forward_batch)
+
+        bs = forward_batch.dllm_block_size or self.block_size
+        rids = list(forward_batch.rids[: forward_batch.batch_size])
+        self._decide(rids=rids)
+        states = [self._states[r] for r in rids]
+        for b, s in enumerate(states):
+            forward_batch.input_ids[b * bs] = s.seed
+
+        steps = self._denoise(
+            model_runner=model_runner,
+            forward_batch=forward_batch,
+            dlm_idx=[b for b, s in enumerate(states) if s.mode == ACTION_DLM],
+            bs=bs,
+        )
+        out = self._causal_commit_pass(
+            model_runner=model_runner, forward_batch=forward_batch
+        )
+        next_token_ids = self._finish_call(
+            rids=rids,
+            states=states,
+            ids=forward_batch.input_ids,
+            full_logits=out.logits_output.full_logits,
+            hidden=model_runner.model.last_hidden_states,
+            steps=steps,
+            bs=bs,
+            eos_id=self._get_eos_id(model_runner),
+        )
+        return out.logits_output, next_token_ids, None, None, out.can_run_graph
+
+    # ------------------------------------------------------------- prefill
+    def _prefill(self, *, model_runner: ModelRunner, forward_batch: ForwardBatch):
+        """Prompt pass (no masks): store seed and boundary state per request."""
+        if forward_batch.input_ids.numel() == 0:
+            empty = LogitsProcessorOutput(next_token_logits=None, full_logits=None)
+            return empty, [], None, None, False
+        out = model_runner.forward(forward_batch, pp_proxy_tensors=None)
+        next_logits = out.logits_output.next_token_logits
+        hidden = model_runner.model.last_hidden_states
+        last_idx = forward_batch.extend_start_loc + forward_batch.extend_seq_lens - 1
+        entropy, top1 = RouterPolicy.logit_stats(next_logits)
+        hidden_cpu = hidden[last_idx].float().cpu()
+        for b, rid in enumerate(forward_batch.rids[: forward_batch.batch_size]):
+            # Chunked prefill: the last chunk's state overwrites earlier ones.
+            self._remember(
+                rid=rid,
+                state=_ReqState(
+                    seed=self._argmax_token(next_logits[b]),
+                    hidden=hidden_cpu[b],
+                    entropy=float(entropy[b]),
+                    top1=float(top1[b]),
+                ),
+            )
+        return out.logits_output, [], None, None, out.can_run_graph
+
+    # ------------------------------------------------------------- decide
+    def _decide(self, *, rids: List[str]) -> None:
+        """Runs the router for requests at a decision point."""
+        need = []
+        for r in rids:
+            s = self._states[r]
+            if s.mode is not None:
+                continue
+            if s.num_generated < self.forced_ar_tokens:
+                s.mode = ACTION_AR
+                s.ar_left = min(self.ar_chunk, self.forced_ar_tokens - s.num_generated)
+            else:
+                need.append(r)
+        if not need:
+            return
+        states = [self._states[r] for r in need]
+        feats = RouterPolicy.assemble(
+            torch.stack([s.hidden for s in states]),
+            torch.tensor([s.entropy for s in states]),
+            torch.tensor([s.top1 for s in states]),
+            torch.tensor([float(s.last_dlm) for s in states]),
+        )
+        device = next(self._router.parameters()).device
+        actions, logp = self._router.act(feats.to(device), mode=self.policy_mode)
+        feats_np = feats.numpy()  # float32, exactly what the policy saw
+        for i, (rid, s) in enumerate(zip(need, states)):
+            s.mode = int(actions[i])
+            s.ar_left = 0 if s.mode == ACTION_DLM else self.ar_chunk
+            self._trace(
+                rid=rid,
+                record={
+                    "type": "decision",
+                    "action": s.mode,
+                    "logp": float(logp[i]),
+                    "num_generated": s.num_generated,
+                    "features": base64.b64encode(feats_np[i].tobytes()).decode(),
+                },
+            )
+
+    # ------------------------------------------------------------- denoise
+    def _denoise(
+        self,
+        *,
+        model_runner: ModelRunner,
+        forward_batch: ForwardBatch,
+        dlm_idx: List[int],
+        bs: int,
+    ) -> List[int]:
+        """Fills diffusion blocks; returns denoising passes per request."""
+        ids = forward_batch.input_ids
+        steps = [0] * forward_batch.batch_size
+        active = list(dlm_idx)
+        for _ in range(bs):
+            active = [
+                b for b in active if (ids[b * bs : (b + 1) * bs] == self.mask_id).any()
+            ]
+            if not active:
+                break
+            fb = (
+                forward_batch
+                if len(active) == forward_batch.batch_size
+                else self._compact_forward_batch(forward_batch, active)
+            )
+            full = model_runner.forward(fb, pp_proxy_tensors=None).logits_output.full_logits
+            for i, b in enumerate(active):
+                steps[b] += 1
+                self._unmask_step(
+                    block=ids[b * bs : (b + 1) * bs], logits=full[i * bs : (i + 1) * bs]
+                )
+        return steps
+
+    def _unmask_step(self, *, block: torch.Tensor, logits: torch.Tensor) -> None:
+        """Commits the most confident mask plus all masks >= threshold."""
+        mask = block == self.mask_id
+        x0, conf = self._compute_confidence(logits, mask, block, torch.zeros_like(mask))
+        k = max(1, int((conf >= self.threshold).sum()))
+        k = min(k, int(mask.sum()))
+        _, top = torch.topk(conf, k=k)
+        block[top] = x0[top]
+
+    # ------------------------------------------------------------- commit
+    def _causal_commit_pass(
+        self, *, model_runner: ModelRunner, forward_batch: ForwardBatch
+    ):
+        """One causal pass over all blocks; persists KV."""
+        forward_batch.dllm_causal_kv_update = True
+        try:
+            return model_runner.forward(forward_batch, pp_proxy_tensors=None)
+        finally:
+            forward_batch.dllm_causal_kv_update = False
+
+    def _finish_call(
+        self,
+        *,
+        rids: List[str],
+        states: List[_ReqState],
+        ids: torch.Tensor,
+        full_logits: torch.Tensor,
+        hidden: torch.Tensor,
+        steps: List[int],
+        bs: int,
+        eos_id: Optional[int],
+    ) -> List[torch.Tensor]:
+        """Returns committed tokens and advances each request's state."""
+        next_token_ids = []
+        for b, (rid, s) in enumerate(zip(rids, states)):
+            is_dlm = s.mode == ACTION_DLM
+            tokens = ids[b * bs : (b + 1) * bs].clone() if is_dlm else ids[b * bs : b * bs + 1].clone()
+            finished = eos_id is not None and bool((tokens == eos_id).any())
+            if finished:
+                tokens = tokens[: int((tokens == eos_id).to(torch.int32).argmax()) + 1]
+            next_token_ids.append(tokens)
+            self._trace(
+                rid=rid,
+                record={
+                    "type": "call",
+                    "action": s.mode,
+                    "tokens": int(tokens.numel()),
+                    "nfe": steps[b] + 1,
+                },
+            )
+            if finished:
+                self._states.pop(rid, None)
+                continue
+            pos = b * bs + (bs - 1 if is_dlm else 0)
+            s.num_generated += int(tokens.numel())
+            s.seed = self._argmax_token(full_logits[pos])
+            s.hidden = hidden[pos].float().cpu()
+            entropy, top1 = RouterPolicy.logit_stats(full_logits[pos])
+            s.entropy, s.top1 = float(entropy), float(top1)
+            s.last_dlm = is_dlm
+            s.ar_left = s.ar_left - 1 if not is_dlm else 0
+            if s.ar_left <= 0:
+                s.mode = None
+        return next_token_ids
+
+    # ------------------------------------------------------------- helpers
+    def _argmax_token(self, logits: torch.Tensor) -> int:
+        logits = logits.float().clone()
+        logits[self.mask_id] = -np.inf
+        return int(torch.argmax(logits))
+
+    def _remember(self, *, rid: str, state: _ReqState) -> None:
+        self._states[rid] = state
+        self._states.move_to_end(rid)
+        while len(self._states) > _MAX_TRACKED_REQUESTS:
+            self._states.popitem(last=False)
+
+    def _trace(self, *, rid: str, record: dict) -> None:
+        if not self.trace_dir:
+            return
+        with open(os.path.join(self.trace_dir, f"{rid}.jsonl"), "a") as f:
+            f.write(json.dumps(record) + "\n")
+
+
+Algorithm = RoutedDecoding
